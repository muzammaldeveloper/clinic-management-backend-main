# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase / Railway / Neon etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Auth ────────────────────────────────────────────────────────────────────
# Strong random string — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Your deployed frontend URL
FRONTEND_URL=https://your-frontend.vercel.app
